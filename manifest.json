{
  "manifest_version": 3,
  "name": "SOCi URL Helper",
  "version": "1.0",
  "description": "Quickly edit tenant and account ID in SOCi URLs",
  "permissions": ["tabs", "activeTab"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOCi URL Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
