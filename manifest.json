{
  "manifest_version": 3,
  "name": "SOCi Support Helper",
  "version": "1.0",
  "description": "SOCi support shortcuts: build admin URLs, look up tickets, grab session credentials, and jump to internal listings tools",
  "permissions": ["tabs", "activeTab", "webRequest", "storage"],
  "host_permissions": ["*://*.meetsoci.com/*", "*://meetsoci.zendesk.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SOCi Support Helper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
